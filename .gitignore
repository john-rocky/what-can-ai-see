# Video, and anything derived from it, is not ours to redistribute.
#
# Pexels' licence is "free to use, no attribution required" but it does NOT permit
# redistributing the file itself, and a contact sheet is the file with most of its
# frames thrown away. kantine's recordings are Apache-2.0 and could be shipped, but
# they are gigabytes and everyone can fetch them from the source.
#
# So the repo carries what this project actually made: the harness, the questions,
# the ground truth, and every answer every model gave. `clips/*/meta.yaml` records
# the Pexels id and URL of each clip, so the corpus is reconstructible from it.
clips/**/*.mp4
runs/stream/**/windows/
runs/**/*.jpg
runs/**/*.png
cards/
site/index.html
clips/**/verify/

# build output
runner/.build/
**/__pycache__/
.DS_Store
clips/**/*.png
clips/**/*.jpg

# iOS build products. The generated .xcodeproj is derived from project.yml by xcodegen —
# committing it means every regeneration is a diff nobody reads.
phone/*.xcodeproj/
walk/*.xcodeproj/
phone/Resources/
walk/Resources/gate/*.jpg
**/DerivedData/
**/.build_xcode/

# Downloaded source films. Public domain, but 100-400 MB each and re-fetchable from the
# archive.org ids recorded in clips/*/meta.yaml.
sources/film/
